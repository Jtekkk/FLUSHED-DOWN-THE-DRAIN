{
  "name": "flushed-down-the-drain",
  "version": "1.0.0",
  "description": "FLUSHED: Down the Drain — a one-button gross-out auto-swimmer. Be Sir Reginald Bubbles III, a flushed goldfish; dodge the brown, eat the corn, reach the ocean.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "serve": "node tools/serve.js",
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:win:portable": "electron-builder --win portable --x64",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleRelease",
    "android:apk:debug": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "keywords": ["game", "html5", "canvas", "electron", "capacitor", "android", "windows"],
  "author": "Sir Reginald Bubbles III",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "build": {
    "appId": "com.reginald.flushed",
    "productName": "Flushed - Down the Drain",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "icon": "www/assets/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "Flushed-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Flushed"
    },
    "portable": {
      "artifactName": "Flushed-${version}-portable.${ext}"
    }
  }
}

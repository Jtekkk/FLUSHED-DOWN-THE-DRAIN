# dependencies
node_modules/

# build output
dist/
*.exe
*.apk
*.aab

# Capacitor / Android build artifacts (the android/ project itself IS committed)
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/local.properties
.gradle/
build/

# Web assets are the source of truth in www/. The copy Capacitor syncs into the
# native project is regenerated by `cap sync` (CI + local builds run it), so we
# don't commit it — avoids duplicating the bundled audio/assets.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# logs / os cruft
*.log
.DS_Store
Thumbs.db
